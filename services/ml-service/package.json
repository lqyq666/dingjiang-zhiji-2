{
  "name": "@dingjiang/ml-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "uv build --out-dir dist",
    "dev": "uv run uvicorn app.main:app --reload --port 8000",
    "lint": "uv run --extra dev ruff check .",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "uv run --extra dev pytest",
    "typecheck": "uv run --extra dev mypy app tests"
  }
}
