# VS17 local-safe defaults. Copy to .env; do not commit .env or paste credentials into chat.
COZE_PROVIDER_MODE=DEMO_RULES
COZE_API_TOKEN=
COZE_EXTRACT_WORKFLOW_ID=
COZE_PUBLISH_WORKFLOW_ID=
COZE_ANSWER_WORKFLOW_ID=

FEISHU_PROVIDER_MODE=DEMO_RULES
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=
FEISHU_REVIEW_TABLE_ID=

# ---------------------------------------------------------------------------
# Dingjiang MCP adapter
# ---------------------------------------------------------------------------
# Required. Generate a local-only token yourself; the API and the MCP process
# must use the same value, and it must never be committed.
DINGJIANG_API_BASE_URL=http://127.0.0.1:3001/api
DINGJIANG_MCP_API_TOKEN=

# Optional: pin the token to specific hosts (comma separated). Empty means no pin.
DINGJIANG_API_ALLOWED_HOSTS=

# Optional: business (default) or compatibility tool surface.
DINGJIANG_MCP_TOOL_SURFACE=

# Optional: 1 serves read-only tools. 0 or unset enables the regular governed surface.
DINGJIANG_MCP_READ_ONLY=

# Remote MCP settings for pnpm --filter @dingjiang/mcp start:http.
# Use the public HTTPS /mcp URL as the OAuth resource, with a loopback listener.
DINGJIANG_MCP_HTTP_URL=
DINGJIANG_MCP_HTTP_PORT=3002
# Trusted OAuth issuer identifier and its configured JWKS URL.
DINGJIANG_MCP_OAUTH_ISSUER=
DINGJIANG_MCP_OAUTH_JWKS_URL=
# JSON array of {subject, integrationToken}. Put credentials in the process secret store.
DINGJIANG_MCP_OAUTH_BINDINGS_JSON=

# Optional: request timeout in ms (100-120000, default 10000).
DINGJIANG_MCP_TIMEOUT_MS=

# Optional: max JSON line size over stdio (default 1048576, max 67108864).
DINGJIANG_MCP_MAX_LINE_BYTES=

# Optional: max queued requests before the server answers QUEUE_OVERFLOW
# (default 64, max 1024). Guards memory when a handler is slow.
DINGJIANG_MCP_MAX_PENDING_REQUESTS=

# Optional: project allowlist for the single-token compatibility mode.
DINGJIANG_MCP_PROJECT_IDS=

# Optional: JSON roster for multi-identity mode. Mutually exclusive with the
# project allowlist above.
DINGJIANG_MCP_TOKEN_BINDINGS_JSON=

# Optional: file holding the build identity reported in initialize.
DINGJIANG_MCP_BUILD_IDENTITY_FILE=

# Integration API rate limiting is on by default; set to 0 to shed it during an
# incident. Ceilings are per credential, per minute.
DINGJIANG_RATE_LIMIT_ENABLED=1
DINGJIANG_RATE_LIMIT_READ_PER_MIN=360
DINGJIANG_RATE_LIMIT_WRITE_PER_MIN=60

# ---------------------------------------------------------------------------
# API production switches. All off by default; read SECURITY.md before enabling.
# ---------------------------------------------------------------------------
# production, or empty for demo mode. Production refuses the demo tenant and
# requires DATABASE_URL, an HTTPS WEB_ORIGIN, an explicit tenant and target OTD.
DINGJIANG_DEPLOYMENT_MODE=

# Required in production mode; not prefixed with DINGJIANG_.
DATABASE_URL=
WEB_ORIGIN=

DINGJIANG_TENANT_ID=
DINGJIANG_COMPANY_NAME=
DINGJIANG_TARGET_OTD=
DINGJIANG_PUBLIC_URL=
DINGJIANG_TRUST_PROXY=

# Writes stay off until an accepted release reference is supplied.
DINGJIANG_PRODUCTION_WRITES=
DINGJIANG_WRITE_ACCEPTANCE_REF=

# Optional baseline migration cutoff for environments that pin their schema.
DINGJIANG_BASELINE_MIGRATIONS=

# Per-command kill switches for governed writes.
DINGJIANG_MATERIAL_CREATE_ENABLED=
DINGJIANG_EVIDENCE_PROPOSE_ENABLED=
DINGJIANG_WORKPAPER_PROPOSE_ENABLED=
